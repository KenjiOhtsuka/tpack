{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "spec-discussion",
  "mcp": {
    "github": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-github"],
      "enabled": true,
      "environment": {
        "GITHUB_TOKEN": "{env:GITHUB_TOKEN}"
      }
    }
  },
  "agent": {
    "spec-discussion": {
      "description": "Discusses feature specifications and manages GitHub issues for planning.",
      "mode": "primary",
      "model": "anthropic/claude-sonnet-4-6",
      "permission": {
        "edit": "deny",
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "bash": "allow"
      }
    }
  }
}
